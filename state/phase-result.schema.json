{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "phase",
    "status",
    "assumptions",
    "missingContext",
    "falsifiers",
    "authoritativeInputs",
    "conflicts",
    "residualOwnerDecisions",
    "nextActions",
    "terminalGate",
    "evidence"
  ],
  "properties": {
    "phase": {
      "enum": ["reconcile", "challenge", "terminal-audit"]
    },
    "status": {
      "enum": ["pass", "fail", "blocked"]
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "missingContext": {
      "type": "array",
      "items": { "type": "string" }
    },
    "falsifiers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "authoritativeInputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "evidence", "state"],
        "properties": {
          "claim": { "type": "string" },
          "evidence": { "type": "string" },
          "state": { "enum": ["resolved", "unresolved", "falsified"] }
        }
      }
    },
    "residualOwnerDecisions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "nextActions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "terminalGate": { "type": "string" },
    "evidence": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
