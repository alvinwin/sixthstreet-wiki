      "id": "62000067",
      "name": "Final Concerto",
      "description": "Agent's Ultimate and Chain Attack DMG increase by 40%. When Chain Attack hits an enemy, the enemy's Stun DMG Multiplier increases by 20% and Daze Recovery Speed slows down by 15% for 15s. Repeated triggers reset the duration."
    },
    {
      "id": "62000071",
      "name": "Rime and Thunder Breach",
      "description": "Agent Ice DMG and Electric DMG increase by 30%. After an Agent with Attack specialty uses an EX Special Attack, their CRIT DMG increases by 30% for 20s. Repeated triggers reset the duration."
    }
